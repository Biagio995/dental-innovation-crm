APP_NAME="Dental Innovation CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dental_crm
DB_USERNAME=dental
DB_PASSWORD=dental_staging

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,localhost:5173,127.0.0.1,127.0.0.1:8080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@dental.local"
MAIL_FROM_NAME="${APP_NAME}"

# Seed credentials (staging/development only)
# These are used by DatabaseSeeder to create initial users
SEED_OWNER_EMAIL=owner@dental.local
SEED_OWNER_PASSWORD=ChangeMe!Owner1
SEED_ADMIN_EMAIL=admin@dental.local
SEED_ADMIN_PASSWORD=ChangeMe!Admin1
SEED_OPERATOR_EMAIL=operator@dental.local
SEED_OPERATOR_PASSWORD=ChangeMe!Operator1
